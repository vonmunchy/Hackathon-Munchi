# Convex (populated after `npx convex dev`)
CONVEX_DEPLOYMENT=your-convex-deployment
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud

# Swipe Mock API
SWIPE_API_BASE_URL=http://127.0.0.1:8080
SWIPE_CLIENT_ID=your_client_id
SWIPE_CLIENT_SECRET=your_client_secret
# Set to true for Vercel deployment (mock can't be reached from cloud)
SWIPE_DEMO_MODE=false

# Meta API (optional — enables direct Instagram/Facebook publishing)
# Get these from developers.facebook.com using Development Mode
META_APP_ID=
META_APP_SECRET=
META_PAGE_ID=
META_PAGE_ACCESS_TOKEN=
META_IG_ACCOUNT_ID=

# Anthropic (optional — enables AI-powered caption generation)
ANTHROPIC_API_KEY=
